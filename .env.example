# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL for PostgreSQL (Object Method runtime variables — injected on Cloud Run)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Server-side AES-256-GCM encryption key for tenant_integrations credentials
CREDENTIALS_ENCRYPTION_KEY=

# Firebase Web SDK Configuration (optional override over firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional Firebase Email/Password Demo Account (leave blank to use instant built-in Demo Workspace)
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

